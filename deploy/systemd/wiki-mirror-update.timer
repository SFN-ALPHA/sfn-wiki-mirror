# Nightly trigger for wiki-mirror-update.service: with this timer enabled, the mirror follows main
# by itself.
#
# **Opt-in.** The unit is always installed, but install.sh enables it only with --auto-update (or
# when it is already enabled), because the update applies whatever is pushed to main, as root, with
# nobody reviewing it first. Whether to trust that is the operator's decision.
#
# 02:20 is a quiet hour, when nobody is searching.
#
# **02:20 is LOCAL time: the container's own time zone decides when this runs.** No zone is
# written in the OnCalendar line on purpose, so the file carries nobody's location. A new
# container is usually on UTC, which is probably not the zone your clients live in: set it
# once (`timedatectl set-timezone <Region/City>`; `timedatectl` shows the current one), and
# check the next run with `systemctl list-timers wiki-mirror-update`. (The build timer next to
# this one is in UTC deliberately: it follows Wikimedia's own UTC publishing schedule.)
#
# RandomizedDelaySec is small on purpose: one host, and a predictable time is worth more than
# spreading load nobody else shares. Persistent=true runs a missed update at the next boot rather
# than skipping a night and drifting.
#
# Most nights this finds nothing new ("current"). A build that is running (the semantic one can
# last days) turns the run into a quiet "deferred", not a failed unit; a commit that changes the
# on-disk format is "held" for a person. See update.sh and docs/OPERATIONS.md R.9 / R.10.
#
# Install: install.sh --auto-update enables it; without that flag it is installed and left off.
# To turn it on later (once):
#          systemctl enable --now wiki-mirror-update.timer
#          systemctl list-timers wiki-mirror-update
# To stop auto-updating: systemctl disable --now wiki-mirror-update.timer (re-running install.sh
# without --auto-update leaves it as it is). `wiki-mirror update` keeps working by hand.
#
# See docs/DESIGN.md section 12 and docs/OPERATIONS.md.

[Unit]
Description=Nightly Wikipedia mirror update (02:20 local time)
Documentation=file:///opt/wiki-mirror/docs/OPERATIONS.md

[Timer]
OnCalendar=*-*-* 02:20:00
RandomizedDelaySec=300
Persistent=true
Unit=wiki-mirror-update.service

[Install]
WantedBy=timers.target
