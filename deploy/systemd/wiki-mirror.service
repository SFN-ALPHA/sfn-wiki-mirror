# The mirror API - search and read over a local mirror of English Wikipedia.
#
# Serves /v1/wiki/search, /v1/wiki/article and /v1/wiki/health on :8300 to the main client, and /mcp
# (MCP over Streamable HTTP) to other agents on the LAN. nftables admits only the site's LAN
# (LAN_CIDR in /etc/wiki-mirror/site.env) on that port and every route requires a key: the main client's from mirror.env, each other agent's
# from clients.json (hashes; `wiki-mirror key add|revoke`, picked up within seconds, no restart).
# It reads the article store, build state and clients.json from disk and queries Qdrant over
# loopback; it never writes data and has no egress (nftables drops anything it tries to open).
# A monthly rebuild is picked up by itself: no restart (it follows the Qdrant alias).
#
# Runs as `wikimirror`, not the build user: this process faces the network and renders text
# anyone can edit, so it holds neither the Enterprise sign-in (wikimirror-sync's, 0600) nor any
# write access to the data. The data directory is read-only to it by ReadOnlyPaths.
#
# Starts after Qdrant because a search service without its index answers every query with
# nothing - a failure that looks like an empty Wikipedia.
#
# Memory: capped at 1.5 G so a runaway request cannot starve a build or Qdrant on this 8 GB box.
#
# Install: install.sh does it. By hand:
#   cp wiki-mirror.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now wiki-mirror
#
# See docs/DESIGN.md sections 5 and 6, docs/OPERATIONS.md.

[Unit]
Description=Wikipedia mirror service (search and read API)
Documentation=file:///opt/wiki-mirror/docs/OPERATIONS.md
After=network.target wiki-mirror-qdrant.service
Requires=wiki-mirror-qdrant.service

[Service]
Type=exec
User=wikimirror
Group=wikimirror
# The code that runs is the venv's installed copy, never whatever the working directory holds:
# `-I` (isolated mode: no cwd or script directory on sys.path, no PYTHON* environment
# variables, no user site) keeps it so, and `/` is a working directory nobody can write to. The
# data directory would not do: the build user writes there, and this process faces the network.
# `-I` rather than `-P` alone because it also closes PYTHONPATH and friends; this unit sets no
# PYTHON* variable, so nothing is lost. The parse and index workers a build spawns inherit the
# flag (multiprocessing re-passes it) and the parent's sys.path - see the build unit.
WorkingDirectory=/
ExecStart=/opt/wiki-mirror/.venv/bin/python -I -m wiki_mirror serve
# WIKI_MIRROR_API_KEY. systemd reads this file as root before dropping privileges, which
# is why it can be root:root 0600 and unreadable to the service itself.
EnvironmentFile=/etc/wiki-mirror/mirror.env
UMask=0027

Restart=on-failure
RestartSec=5s
# Exit 2 is the program saying "my configuration is wrong" (a missing or short key, a malformed
# clients.json): restarting cannot fix it and would only loop every 5 s. Exit 1 (Qdrant not up
# yet) is a different matter and is retried.
RestartPreventExitStatus=2
TimeoutStopSec=30

MemoryMax=1500M

# Hardening. MemoryDenyWriteExecute is left off on purpose: cffi (argon2, cryptography)
# allocates executable memory.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/wiki-mirror /etc/wiki-mirror
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
