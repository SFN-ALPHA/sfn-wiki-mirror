#!/usr/bin/env bash
#
# `wiki-mirror` - the operator command for the mirror's container (the Wikipedia mirror).
#
# Installed by install.sh as a symlink at /usr/local/bin/wiki-mirror into the checkout, so a change
# here is live the moment `wiki-mirror update` pulls it. A single file with a case statement rather
# than one file per verb: five verbs do not earn a dispatcher.
#
# Usage:
#   wiki-mirror status                  the mirror's health, the units, the next scheduled build
#   wiki-mirror build-now               start a build now (hours; follow it with `wiki-mirror logs build`)
#   wiki-mirror embed-now               start the semantic index's embedding run (about two days; follow it
#                                 with `wiki-mirror logs embed`; resumes where it stopped)
#   wiki-mirror logs [api|build|embed|maintain|qdrant]
#                                 follow a unit's journal (default: api); maintain is the
#                                 15-minute job that heals and reports on Qdrant
#   wiki-mirror update [--accept-format-change]
#                                 fast-forward the checkout, reinstall, restart the API; the
#                                 flag allows a commit that changes the built data's format
#   wiki-mirror search "<query>" [limit] [--mode lexical|semantic|hybrid]
#                                 a quick local search through the real API (default mode: lexical)
#   wiki-mirror key add <name>          issue an API key to another agent (shown once, only its hash kept)
#   wiki-mirror key list                the agents that have a key (names only)
#   wiki-mirror key revoke <name>       withdraw an agent's key (takes effect in seconds, no restart)
#
# Not on PATH in the shell `pct enter <ctid>` gives (it lacks /usr/local/bin): run `exec bash -l`
# first, or call /usr/local/bin/wiki-mirror. Over SSH it is found as usual.
#
# Needs root: the API key lives in a root-only file. The key is read into a curl config on a
# pipe and is never echoed, never put on a command line and never written anywhere. `key add`
# is the one command that prints a key, once, on stdout.
#
# See docs/OPERATIONS.md and deploy/README.md.

set -euo pipefail

# Resolved through the /usr/local/bin symlink to <checkout>/deploy/wiki-mirror, so the checkout
# is two levels up: deploy/ and then the checkout itself. (tests/deploy/test_cli.py runs it that way.)
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="${APP_DIR:-$(dirname "$(dirname "$SELF")")}"
CONF_DIR="${CONF_DIR:-/etc/wiki-mirror}"
MIRROR_ENV="$CONF_DIR/mirror.env"
VENV="$APP_DIR/.venv"
API_URL="${WIKI_MIRROR_API_URL:-http://127.0.0.1:8300}"

API_UNIT=wiki-mirror.service
QDRANT_UNIT=wiki-mirror-qdrant.service
BUILD_UNIT=wiki-mirror-build.service
BUILD_TIMER=wiki-mirror-build.timer
EMBED_UNIT=wiki-mirror-embed.service
MAINTAIN_UNIT=wiki-mirror-maintain.service
MAINTAIN_TIMER=wiki-mirror-maintain.timer
UPDATE_TIMER=wiki-mirror-update.timer

if [[ -t 1 ]]; then
    BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
    YELLOW=$'\033[33m'; RESET=$'\033[0m'
else
    BOLD=""; DIM=""; RED=""; GREEN=""; YELLOW=""; RESET=""
fi

head2() { printf '\n%s%s%s\n' "$BOLD" "$*" "$RESET"; }
good()  { printf '  %s+%s %s\n' "$GREEN" "$RESET" "$*"; }
bad()   { printf '  %s!%s %s\n' "$RED" "$RESET" "$*"; }
warn()  { printf '  %s!%s %s\n' "$YELLOW" "$RESET" "$*"; }
dim()   { printf '  %s%s%s\n' "$DIM" "$*" "$RESET"; }
die()   { printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

# `id -u` rather than $EUID, as update.sh does: the variable is read-only in bash, so a test
# cannot stand in for root, while a stub `id` on PATH can.
require_root() {
    [[ "$(id -u)" -eq 0 ]] || die "'$1' needs root - try: sudo wiki-mirror $1"
}

# GET or POST to the API. The key goes to curl as a config file on a pipe (`-K <(...)`), so
# it never appears in `ps` or in this script's output. $1 is the path; any further arguments
# go to curl (e.g. a JSON body). An HTTP error status fails the call (exit 22) but, with
# --fail-with-body (curl 7.76; Debian 12 has 7.88), still prints the reply's body, so a caller can
# show the service's own `{"error", "detail"}` reason instead of curl's bare status line.
api_call() {
    local path="$1" key
    shift
    key="$(sed -n 's/^WIKI_MIRROR_API_KEY=//p' "$MIRROR_ENV" 2>/dev/null | head -1)"
    [[ -n "$key" ]] || die "no WIKI_MIRROR_API_KEY in $MIRROR_ENV (run install.sh)"
    curl --fail-with-body -sS --max-time 30 -K <(printf 'header = "Authorization: Bearer %s"\n' "$key") \
        "$@" "$API_URL$path"
}

py() { "$VENV/bin/python" -I "$@"; }

# Shows the lines a Python snippet prints as "<level><TAB><text>" through good/warn/bad/dim, so
# the snippets decide what is wrong while this script stays the one place that knows the colours.
render() {
    local level text
    while IFS=$'\t' read -r level text; do
        case "$level" in
            good|warn|bad|dim) "$level" "$text" ;;
            *) printf '  %s\n' "$text" ;;
        esac
    done
}

# Prints when a timer fires next, as `systemctl list-timers` shows it ("Sat 2026-10-24 02:22:44
# CDT"), or "unknown" when the timer has no line or no next run. $1 is the timer unit. Not
# `systemctl show -p NextElapseUSecRealtime`: that is empty for a timer on the monotonic clock
# (the maintenance timer's OnBootSec/OnUnitActiveSec), and it exits 0 when empty, so no fallback
# after it ever ran. With --plain the NEXT column is four fields (weekday, date, time, zone), or
# a single "-" when unset; LEFT after it is several words, so only fields 1-4 are taken. The
# unit is the second-to-last field (ACTIVATES is last), which also drops any other line.
timer_next() {
    local next
    next="$(systemctl list-timers "$1" --all --no-legend --plain 2>/dev/null \
        | awk -v unit="$1" '$(NF - 1) == unit && $1 != "-" {print $1, $2, $3, $4; exit}' || true)"
    printf '%s' "${next:-unknown}"
}

cmd_status() {
    require_root status
    local health="" state

    head2 "Services"
    for unit in "$QDRANT_UNIT" "$API_UNIT"; do
        state="$(systemctl is-active "$unit" 2>/dev/null || true)"
        if [[ "$state" == active ]]; then
            good "$(printf '%-40s %s' "$unit" "$state")"
        else
            bad "$(printf '%-40s %s' "$unit" "${state:-unknown}")"
        fi
    done
    # The build is a oneshot: "inactive" between runs is normal, and what matters is whether
    # the last run worked. After a failure the unit waits out RestartSec in "auto-restart" and
    # tries again (a few times, then gives up: Result start-limit-hit).
    state="$(systemctl is-active "$BUILD_UNIT" 2>/dev/null || true)"
    local result substate
    result="$(systemctl show "$BUILD_UNIT" -p Result --value 2>/dev/null || true)"
    substate="$(systemctl show "$BUILD_UNIT" -p SubState --value 2>/dev/null || true)"
    if [[ "$substate" == auto-restart ]]; then
        bad "$(printf '%-40s last run FAILED (%s); retrying soon - wiki-mirror logs build' "$BUILD_UNIT" "${result:-unknown}")"
    elif [[ "$state" == active || "$state" == activating ]]; then
        warn "$(printf '%-40s RUNNING (wiki-mirror logs build)' "$BUILD_UNIT")"
    elif [[ -z "$result" || "$result" == success ]]; then
        good "$(printf '%-40s idle, last run ok' "$BUILD_UNIT")"
    else
        bad "$(printf '%-40s last run FAILED (%s) - wiki-mirror logs build' "$BUILD_UNIT" "$result")"
    fi

    head2 "Mirror"
    if health="$(api_call /v1/wiki/health 2>/dev/null)"; then
        printf '%s' "$health" | py -c '
import json, sys

data = json.load(sys.stdin)
build = data.get("build") or {}
rows = [
    ("status", data.get("status")),
    ("snapshot", data.get("snapshot")),
    ("applied snapshot", data.get("applied_snapshot")),
    ("articles", data.get("articles")),
    ("passages", data.get("passages")),
    ("collection", data.get("collection")),
    ("build phase", build.get("phase")),
    ("chunks", "%s downloaded / %s parsed of %s" % (
        build.get("chunks_downloaded"), build.get("chunks_parsed"), build.get("chunks_total"))),
    ("passages indexed", build.get("passages_indexed")),
    ("updated", build.get("updated_at")),
    ("error", build.get("error") or None),
]
last = data.get("update")
if isinstance(last, dict):
    # The last run of update.sh: when, which commits, the outcome, and why.
    rows.append(("last update", "%s  %s  (%s -> %s, %s)" % (
        last.get("at"), last.get("outcome"), last.get("from"), last.get("to") or "-",
        "unattended" if last.get("unattended") else "by hand")))
    rows.append(("update detail", last.get("detail") or None))
for label, value in rows:
    if value is not None:
        print("  %-18s %s" % (label, value))
'
        # Why the status is degraded, one line each (none otherwise).
        printf '%s' "$health" | py -c '
import json, sys

for reason in json.load(sys.stdin).get("reasons") or []:
    print("bad\t" + str(reason))
' | render

        head2 "Semantic index"
        printf '%s' "$health" | py -c '
import json, sys

health = json.load(sys.stdin)
semantic = health.get("semantic")
modes = health.get("search_modes")


def count(value):
    return "{:,}".format(value) if isinstance(value, int) else "?"


if not isinstance(semantic, dict):
    print("dim\tno semantic index yet")
else:
    status = semantic.get("status")
    optimizer = str(semantic.get("optimizer_status") or "ok")
    points, indexed = count(semantic.get("points")), count(semantic.get("indexed_vectors"))
    if optimizer != "ok":
        # Qdrant reports its optimizer failure as the collection being red.
        print("bad\toptimizer failed: " + optimizer.removeprefix("error: "))
    elif status == "green":
        print("good\tready (%s passages)" % points)
    elif status == "yellow":
        print("warn\tbuilding its search graph (%s of %s indexed)" % (indexed, points))
    elif status == "grey":
        print("bad\tpaused - the maintenance job resumes it within 15 minutes")
    else:
        print("warn\tcollection status %s" % status)
    print("%s\tembedding run %s" % (
        "good" if semantic.get("complete") else "dim",
        "complete" if semantic.get("complete") else "not complete"))
    print("dim\tcollection %s" % semantic.get("collection"))
# Which searches work now, and why semantic and hybrid are off when an index exists but cannot be
# searched (D10). A reply from an older API has neither key: say nothing rather than guess.
if isinstance(modes, list):
    print("%s\tsearch modes: %s" % (
        "good" if "semantic" in modes and "hybrid" in modes else "dim", ", ".join(modes) or "none"))
if isinstance(semantic, dict) and semantic.get("searchable_reason"):
    print("warn\tsemantic and hybrid search are off: %s" % semantic["searchable_reason"])
' | render

        head2 "Maintenance"
        printf '%s' "$health" | py -c '
import json, sys
from datetime import UTC, datetime

# The job leaves this every 15 minutes; health calls it stale at 60 (api.MAINTENANCE_STALE_MINUTES).
STALE_MINUTES = 60
# Decimal gigabytes, as docs/SIZING.md counts them.
GB = 10 ** 9
record = json.load(sys.stdin).get("maintenance")


def when(text):
    try:
        return datetime.strptime(text, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=UTC)
    except (TypeError, ValueError):
        return None


if not isinstance(record, dict):
    print("warn\tno maintenance record - enable the timer once: "
          "systemctl enable --now wiki-mirror-maintain.timer")
    raise SystemExit
ran = when(record.get("ran_at"))
if ran is None:
    print("bad\tlast run: time unreadable (%s)" % record.get("ran_at"))
else:
    minutes = int((datetime.now(UTC) - ran).total_seconds() // 60)
    stale = minutes > STALE_MINUTES
    print("%s\tlast run %s (%d minutes ago)%s" % (
        "bad" if stale else "good", record["ran_at"], minutes,
        " - the timer or the job has stopped: wiki-mirror logs maintain" if stale else ""))
unit = record.get("qdrant") or {}
if unit.get("found") is None:
    # systemd could not be asked at all: crashes and memory are not being watched.
    print("bad\tthe Qdrant unit could not be read")
elif not unit.get("found"):
    print("bad\tthe Qdrant unit is not installed")
else:
    crash = unit.get("last_crash_at")
    print("%s\tQdrant restarts after a failure: %s%s" % (
        "warn" if crash else "good", unit.get("restarts"),
        ", last at %s" % crash if crash else ""))
    anon, cap = unit.get("anon_bytes"), unit.get("memory_max_bytes")
    if anon is None:
        print("dim\tQdrant memory unknown")
    elif not cap:
        print("good\tQdrant memory %.1f GB (no cap)" % (anon / GB))
    else:
        share = 100 * anon / cap
        print("%s\tQdrant memory %.1f GB of %.1f GB (%d%%)" % (
            "bad" if share > 90 else "good", anon / GB, cap / GB, round(share)))
last = record.get("last_action")
if isinstance(last, dict):
    print("dim\tlast action %s on %s: %s" % (last.get("at"), last.get("collection"), last.get("detail")))
else:
    print("dim\tno action taken yet")
for collection in record.get("collections") or []:
    if collection.get("held"):
        print("bad\t%s is held: %s" % (collection.get("name"), collection["held"]))
for problem in record.get("problems") or []:
    print("bad\t" + str(problem))
' | render
    else
        # api_call prints an error reply's body (--fail-with-body); status must not take that for
        # a health report, and exits 1 below when the API did not answer.
        health=""
        bad "the API did not answer at $API_URL/v1/wiki/health"
        dim "wiki-mirror logs api"
    fi

    head2 "Schedule"
    if [[ "$(systemctl is-enabled "$BUILD_TIMER" 2>/dev/null || true)" == enabled ]]; then
        good "$(printf '%-40s next %s' "$BUILD_TIMER" "$(timer_next "$BUILD_TIMER")")"
    else
        warn "$BUILD_TIMER is not enabled - no monthly build will run"
    fi
    if [[ "$(systemctl is-enabled "$MAINTAIN_TIMER" 2>/dev/null || true)" == enabled ]]; then
        good "$(printf '%-40s next %s' "$MAINTAIN_TIMER" "$(timer_next "$MAINTAIN_TIMER")")"
    else
        # Unlike the update timer this one is meant to be on everywhere: it only reads, resumes
        # and applies the code's own settings, and without it nobody notices a Qdrant that failed.
        warn "$MAINTAIN_TIMER is not enabled - Qdrant is neither watched nor healed; enable it once: systemctl enable --now $MAINTAIN_TIMER"
    fi
    if [[ "$(systemctl is-enabled "$UPDATE_TIMER" 2>/dev/null || true)" == enabled ]]; then
        good "$(printf '%-40s next %s' "$UPDATE_TIMER" "$(timer_next "$UPDATE_TIMER")")"
    else
        # Not a warning: the nightly update is opt-in (install.sh --auto-update), so off is the
        # normal state of a box whose operator has not chosen to follow upstream.
        dim "$UPDATE_TIMER is not enabled - the box does not update itself; to follow upstream nightly: systemctl enable --now $UPDATE_TIMER (by hand: wiki-mirror update)"
    fi

    head2 "Version"
    dim "$(git -C "$APP_DIR" log --oneline -1 2>/dev/null || echo unknown)"

    head2 "Firewall (refused so far; service_refused should stay 0)"
    local counters
    counters="$(nft list counters 2>/dev/null \
        | awk '/^[[:space:]]*counter / {name = $2} /^[[:space:]]*packets [0-9]+ bytes/ {printf "  %-16s %s packets\n", name, $2}' || true)"
    if [[ -n "$counters" ]]; then
        printf '%s\n' "$counters"
    else
        warn "the wiki_mirror table is not loaded - run install.sh to apply the firewall"
    fi
    printf '\n'
    [[ -n "$health" ]]
}

cmd_build_now() {
    require_root build-now
    # A oneshot is "activating" while its process runs, which `is-active --quiet` does not
    # count as active; "auto-restart" is the wait between retries after a failure, and starting
    # then simply cuts the wait short.
    if [[ "$(systemctl is-active "$BUILD_UNIT" 2>/dev/null || true)" =~ ^(active|activating)$ \
          && "$(systemctl show "$BUILD_UNIT" -p SubState --value 2>/dev/null || true)" != auto-restart ]]; then
        die "a build is already running - follow it with: wiki-mirror logs build"
    fi
    # After the retries have run out the unit sits failed with Result start-limit-hit and
    # refuses to start; a person asking for a build is the reset the limit is waiting for.
    systemctl reset-failed "$BUILD_UNIT" 2>/dev/null || true
    # --no-block: a build takes hours, and the shell should come back.
    systemctl start --no-block "$BUILD_UNIT"
    printf 'Build started. It is checkpointed: a stop or reboot resumes where it left off.\n'
    printf '  follow:  wiki-mirror logs build\n'
    printf '  state:   wiki-mirror status\n'
    printf '  stop:    systemctl stop %s\n' "$BUILD_UNIT"
}

# Starts the embedding run of the semantic index (W2). Like build-now: it resets a spent start
# limit, and starting while the unit waits out RestartSec simply cuts the wait short.
cmd_embed_now() {
    require_root embed-now
    if [[ "$(systemctl is-active "$EMBED_UNIT" 2>/dev/null || true)" =~ ^(active|activating)$ \
          && "$(systemctl show "$EMBED_UNIT" -p SubState --value 2>/dev/null || true)" != auto-restart ]]; then
        die "an embedding run is already going - follow it with: wiki-mirror logs embed"
    fi
    systemctl reset-failed "$EMBED_UNIT" 2>/dev/null || true
    # --no-block: the run takes days, and the shell should come back.
    systemctl start --no-block "$EMBED_UNIT"
    printf 'Embedding run started. It is checkpointed: a stop, a failure or a reboot resumes where it left off.\n'
    printf '  follow:  wiki-mirror logs embed\n'
    printf '  stop:    systemctl stop %s\n' "$EMBED_UNIT"
}

cmd_logs() {
    local unit
    case "${1:-api}" in
        api)    unit="$API_UNIT" ;;
        build)  unit="$BUILD_UNIT" ;;
        embed)  unit="$EMBED_UNIT" ;;
        maintain) unit="$MAINTAIN_UNIT" ;;
        qdrant) unit="$QDRANT_UNIT" ;;
        *) die "unknown log '$1' (api|build|embed|maintain|qdrant)" ;;
    esac
    shift || true
    # A finished oneshot has nothing to follow: show its recent history instead of waiting
    # forever on a unit that will not run again until next month (or, for the maintenance job,
    # until the next quarter hour).
    if [[ "$unit" == "$BUILD_UNIT" || "$unit" == "$EMBED_UNIT" || "$unit" == "$MAINTAIN_UNIT" ]] \
       && ! [[ "$(systemctl is-active "$unit" 2>/dev/null || true)" =~ ^(active|activating)$ ]]; then
        exec journalctl -u "$unit" -n 100 --no-pager "$@"
    fi
    exec journalctl -u "$unit" -f -n 60 "$@"
}

cmd_update() {
    require_root update
    exec "$APP_DIR/deploy/update.sh" "$@"
}

# `search "<query>" [limit] [--mode lexical|semantic|hybrid]`. The mode is checked here, so a typo
# is a usage error and not a request; it is sent only when given, so the service's own default
# (lexical) stays the one place that decides it. A semantic or hybrid search the service cannot
# serve (503 semantic_unavailable, D10) prints its reason; it never falls back to keywords.
cmd_search() {
    require_root search
    local usage='usage: wiki-mirror search "<query>" [limit] [--mode lexical|semantic|hybrid]'
    local mode="" have_mode=false limit reply status=0
    local -a positional=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode)   [[ $# -ge 2 ]] || die "--mode needs a value; $usage"
                      mode="$2"; have_mode=true; shift ;;
            --mode=*) mode="${1#--mode=}"; have_mode=true ;;
            --*)      die "unknown option '${1:0:30}'; $usage" ;;
            *)        positional+=("$1") ;;
        esac
        shift
    done
    if $have_mode; then
        case "$mode" in
            lexical|semantic|hybrid) ;;
            *) die "unknown mode '${mode:0:20}' (lexical|semantic|hybrid); $usage" ;;
        esac
    fi
    [[ ${#positional[@]} -ge 1 && ${#positional[@]} -le 2 && -n "${positional[0]}" ]] || die "$usage"
    limit="${positional[1]:-5}"
    [[ "$limit" =~ ^[0-9]+$ ]] || die "limit must be a whole number; $usage"

    # The body is built by Python so quotes in the query cannot break the JSON.
    reply="$(py -c '
import json, sys

body = {"query": sys.argv[1], "limit": int(sys.argv[2])}
if sys.argv[3]:
    body["mode"] = sys.argv[3]
print(json.dumps(body))
' "${positional[0]}" "$limit" "$mode" \
        | api_call /v1/wiki/search -H 'Content-Type: application/json' --data-binary @-)" || status=$?
    # Nothing came back (the API is down, or there is no key): curl or die has said why.
    if [[ $status -ne 0 && -z "$reply" ]]; then
        exit 1
    fi
    printf '%s' "$reply" | py -c '
import json, sys

try:
    reply = json.load(sys.stdin)
except ValueError:
    print("error: the API answered something that is not JSON", file=sys.stderr)
    raise SystemExit(1)
if isinstance(reply, dict) and "error" in reply:
    # The service error shape, {"error": code, "detail": reason}. For a semantic or hybrid search
    # it cannot serve, `detail` is the plain reason: never the query or a key.
    print("error: %s: %s" % (reply["error"], reply.get("detail") or "-"), file=sys.stderr)
    if reply["error"] == "semantic_unavailable":
        print("  lexical search still works; wiki-mirror status shows which modes are usable", file=sys.stderr)
    raise SystemExit(1)
print("snapshot %s, mode %s, %d result(s)" % (reply.get("snapshot"), reply.get("mode"), len(reply.get("results", []))))
for hit in reply.get("results", []):
    print()
    # %.4g suits every mode: a BM25 sum (12.35), a cosine similarity (0.8234) and a reciprocal-rank-fusion
    # sum (0.03279), which %.2f would show as 0.03 for every hit.
    print("%s  [%s]  score %.4g" % (hit["title"], hit.get("section") or "-", hit.get("score", 0)))
    print("  %s" % hit["url"])
    print("  %s" % (hit.get("snippet") or "")[:200])
'
    [[ $status -eq 0 ]] || exit 1
}

# The clients file (hashes of the other agents' keys) belongs to the Python module, which
# validates names, writes atomically and keeps the file readable by the API user. This verb only
# hands over: as root, with the venv's interpreter, and the same settings file the service reads.
cmd_key() {
    require_root key
    case "${1:-}" in
        add|revoke) [[ $# -eq 2 && -n "$2" ]] || die "usage: wiki-mirror key $1 <name>" ;;
        list)       [[ $# -eq 1 ]] || die "usage: wiki-mirror key list" ;;
        *) die "unknown key command '${1:-}' (add <name>|list|revoke <name>)" ;;
    esac
    exec "$VENV/bin/python" -I -m wiki_mirror --config "$CONF_DIR/mirror.yaml" key "$@"
}

case "${1:-status}" in
    status)    shift || true; cmd_status "$@" ;;
    build-now) shift; cmd_build_now "$@" ;;
    embed-now) shift; cmd_embed_now "$@" ;;
    logs)    shift; cmd_logs "$@" ;;
    update)    shift; cmd_update "$@" ;;
    search)    shift; cmd_search "$@" ;;
    key)       shift; cmd_key "$@" ;;
    -h|--help|help)
        sed -n '/^# Usage:/,/^#$/p' "$SELF" | sed 's/^# \{0,1\}//'
        ;;
    *) die "unknown command '$1' (status|build-now|embed-now|logs|update|search|key)" ;;
esac
